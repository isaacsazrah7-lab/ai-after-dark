  aiPaused = true;
  conversationVersion++;

  if (lastScheduled) clearTimeout(lastScheduled);
  if (unsubscribeMessages) unsubscribeMessages();

  await signOut(auth);
});

// AUTHENTICATION
onAuthStateChanged(auth, user => {
  if (!user) {
    if (loginScreen) loginScreen.hidden = false;
    if (chatScreen) chatScreen.hidden = true;
    return;
  }

  if (user.uid !== OWNER_UID) {
    signOut(auth);
    showError("This is a private chat.");
    return;
  }

  if (loginScreen) loginScreen.hidden = true;
  if (chatScreen) chatScreen.hidden = false;

  listenForMessages();
});

// FIREBASE MESSAGES
function listenForMessages() {
  if (unsubscribeMessages) unsubscribeMessages();

  const messageQuery = query(
    messagesRef,
    orderBy("createdAt", "asc")
  );

  unsubscribeMessages = onSnapshot(
    messageQuery,
    snapshot => {
      knownMessages = snapshot.docs.map(item => ({
        id: item.id,
        ...item.data()
      }));

      renderMessages();
    },
    error => {
      console.error(error);
      setStatus("Chat connection error.");
    }
  );
}

// SEND MESSAGE
async function sendMessage() {
  const text = messageInput?.value.trim();

  if (!text || !auth.currentUser) return;

  sendButton.disabled = true;

  try {
    await addDoc(messagesRef, {
      uid: auth.currentUser.uid,
      sender: "You",
      text,
      ai: false,
      replyTo: selectedReply,
      reactions: {},
      createdAt: serverTimestamp()
    });

    messageInput.value = "";
    cancelReply();

    // Let the group respond to the new message.
    aiTurns = 0;

    if (!aiPaused && engine) {
      scheduleAI(1800);
    }

  } catch (error) {
    console.error(error);
    setStatus("Could not send message. Please try again.");
  } finally {
    sendButton.disabled = false;
  }
}

sendButton?.addEventListener("click", sendMessage);

messageInput?.addEventListener("keydown", event => {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    sendMessage();
  }
});

// REPLIES
function chooseReply(message) {
  selectedReply = {
    id: message.id,
    sender: message.sender || message.name || "Unknown",
    text: message.text || ""
  };

  if (replyingBox) replyingBox.hidden = false;

  if (replyingTo) {
    replyingTo.textContent = "Replying to " + selectedReply.sender;
  }

  if (replyingText) {
    replyingText.textContent = selectedReply.text;
  }

  messageInput?.focus();
}

function cancelReply() {
  selectedReply = null;

  if (replyingBox) replyingBox.hidden = true;
}

cancelReplyButton?.addEventListener("click", cancelReply);

// REACTIONS
async function reactToMessage(message) {
  const reactions = Array.isArray(message.reactions)
    ? {}
    : { ...(message.reactions || {}) };

  reactions.heart = (reactions.heart || 0) + 1;

  try {
    await updateDoc(doc(db, "messages", message.id), {
      reactions
    });
  } catch (error) {
    console.error("Reaction failed", error);
  }
}

// RENDER MESSAGES
function renderMessages() {
  if (!messagesBox) return;

  messagesBox.replaceChildren();

  knownMessages.forEach(message => {
    const mine =
      message.uid === auth.currentUser?.uid && !message.ai;

    const bubble = document.createElement("div");
    bubble.className = "message" + (mine ? " mine" : "");

    const sender = document.createElement("div");
    sender.className = "sender";
    sender.textContent = message.sender || message.name || "Unknown";

    bubble.appendChild(sender);

    if (message.replyTo) {
      const reply = document.createElement("div");
      reply.className = "reply";

      reply.textContent =
        "↪ " + message.replyTo.sender + ": " +
        message.replyTo.text;

      bubble.appendChild(reply);
    }

    const content = document.createElement("div");
    content.textContent = message.text || "";
    bubble.appendChild(content);

    if (message.audioUrl) {
      const audio = document.createElement("audio");
      audio.controls = true;
      audio.src = message.audioUrl;
      bubble.appendChild(audio);
    }

    const time = document.createElement("div");
    time.className = "time";
    time.textContent = getTime(message.createdAt);
    bubble.appendChild(time);

    const actions = document.createElement("div");
    actions.className = "message-actions";

    const replyButton = document.createElement("button");
    replyButton.textContent = "↩ Reply";
    replyButton.addEventListener("click", () => chooseReply(message));

    const heartButton = document.createElement("button");
    heartButton.textContent =
      "❤️ " + (message.reactions?.heart || 0);

    heartButton.addEventListener("click", () => reactToMessage(message));

    actions.append(replyButton, heartButton);
    bubble.appendChild(actions);

    messagesBox.appendChild(bubble);
  });

  messagesBox.scrollTop = messagesBox.scrollHeight;
}

// LOAD LOCAL AI ON CPU
async function loadLocalAI() {
  if (engine || modelLoading) return;
  if (!loadAIButton) return;

  modelLoading = true;
  loadAIButton.disabled = true;

  setStatus("Preparing local AI on CPU...");

  try {
    const transformers = await import(
      "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.7.2"
    );

    engine = await transformers.pipeline(
      "text-generation",
      MODEL_ID,
      {
        device: "wasm",
        dtype: "q4"
      }
    );

    setStatus("💜 Local AI is ready!");

  } catch (error) {
    console.error("Model loading failed:", error);

    engine = null;
    setStatus("AI could not load. Check the browser console.");
  } finally {
    modelLoading = false;
    loadAIButton.disabled = false;
  }
}

loadAIButton?.addEventListener("click", loadLocalAI);

// GENERATE REPLY
async function generateReply(personality, history) {
  if (!engine) return null;

  const systemPrompt = `
You are ${personality.name}, an AI personality in a fictional group chat called AI AFTER DARK.

Your personality: ${personality.style}

Speak naturally like a person in a South African group chat.
Mix English and Afrikaans naturally when appropriate.
Use casual South African expressions.
Be funny, spontaneous and conversational.
You can disagree, tease and joke harmlessly.
Do not sound like a customer service bot.
React to what people actually said.
Do not repeat the whole conversation.
Keep replies short and natural.
Write only your own chat message.
`;

  const conversation = history.slice(-8).map(message => {
    const sender = message.sender || message.name || "Someone";

    return `${sender}: ${message.text || ""}`;
  }).join("\n");

  const prompt = `
${systemPrompt}

GROUP CHAT:
${conversation}

${personality.name}, write your next message:
`;

  try {
    const result = await engine(prompt, {
      max_new_tokens: 100,
      do_sample: true,
      temperature: 0.85,
      repetition_penalty: 1.12,
      return_full_text: false
    });

    let output = result?.[0]?.generated_text;

    if (typeof output !== "string" && Array.isArray(output)) {
      output = output[output.length - 1]?.content;
    }

    if (typeof output !== "string") return null;

    output = output.trim();

    // Remove accidental speaker labels.
    output = output.replace(
      new RegExp("^" + personality.name + "\\s*:\\s*", "i"),
      ""
    );

    return output.slice(0, 600) || null;

  } catch (error) {
    console.error("AI generation error:", error);
    return null;
  }
}

// SAVE AI MESSAGE
async function postAIMessage(personality, text, version) {
  if (
    !auth.currentUser ||
    auth.currentUser.uid !== OWNER_UID ||
    version !== conversationVersion
  ) return;

  await addDoc(messagesRef, {
    uid: auth.currentUser.uid,
    sender: personality.emoji + " " + personality.name,
    text,
    ai: true,
    reactions: {},
    createdAt: serverTimestamp()
  });
}

// SCHEDULE NEXT AI MESSAGE
function scheduleAI(delay = 4000) {
  if (lastScheduled) clearTimeout(lastScheduled);

  lastScheduled = setTimeout(() => {
    lastScheduled = null;
    continueAIConversation();
  }, delay);
}

// GROUP CHAT ENGINE
async function continueAIConversation() {
  if (
    aiPaused ||
    aiBusy ||
    !engine ||
    aiTurns >= MAX_AI_TURNS ||
    knownMessages.length === 0
  ) return;

  aiBusy = true;
  const version = conversationVersion;

  try {
    const personality =
      personalities[Math.floor(Math.random() * personalities.length)];

    setStatus(personality.emoji + " " + personality.name + " is typing...");

    const history = getLatestMessages();
    const response = await generateReply(personality, history);

    if (
      response &&
      !aiPaused &&
      version === conversationVersion
    ) {
      await postAIMessage(personality, response, version);

      aiTurns++;

      if (aiTurns < MAX_AI_TURNS) {
        scheduleAI(3500 + Math.random() * 5000);
      } else {
        setStatus("The group is taking a little break.");
      }
    } else if (!response) {
      setStatus("AI couldn't generate a reply. Try again.");
    }

  } catch (error) {
    console.error(error);
    setStatus("Something went wrong. Try again.");
  } finally {
    aiBusy = false;
  }
}

